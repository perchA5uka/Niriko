<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 放送提醒通知（阶段 J） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 桌面图标：旧版快捷方式广播（MIUI/HyperOS 上 requestPinShortcut 常不弹窗，走这条兜底通路） -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!-- miuix-blur 声明 minSdk 31(使用 RenderEffect),但其内部有 isRuntimeShaderSupported 降级,
         低版本自动回退静态背景;overrideLibrary 允许项目 minSdk 26 继续使用 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <!-- 传送门（P0）：Android 11+ 包可见性。缺 <queries> 时 resolveActivity 恒为 null，深链/检测会静默降级。
         列出：Bilibili / Steam 包；bilibili、steam 深链 scheme；http/https 网页兜底。 -->
    <queries>
        <package android:name="tv.danmaku.bili" />
        <package android:name="com.valvesoftware.android.steam.community" />
        <package android:name="com.czy0729.bangumi" />
        <package android:name="com.netease.cloudmusic" />
        <package android:name="com.tencent.qqmusic" />
        <package android:name="eu.kanade.tachiyomi" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="bilibili" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="steam" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="orpheus" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="qqmusic" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".NirikoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Niriko">
        <!-- 单 Activity 入口（无 LAUNCHER 过滤：桌面入口由 LauncherAlias 持有，
             以便运行时隐藏/恢复本体图标——见 ui/icon/AppIconManager） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Niriko"
            android:windowSoftInputMode="adjustResize">
            <!-- .nirikotheme 主题包：文件管理器/分享面板直接"打开方式"唤起导入 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.nirikotheme" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.nirikotheme" />
            </intent-filter>
        </activity>

        <!-- 桌面入口别名：默认启用；"生成主题色图标"流程钉入快捷方式后禁用本体 -->
        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 分享临时图片 FileProvider（cacheDir/share/） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 开机恢复放送提醒周期任务（阶段 J） -->
        <receiver
            android:name=".data.notification.AiringReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
